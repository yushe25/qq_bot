{
  "qq": {
    "wsUrl": "ws://127.0.0.1:3001",
    "httpUrl": "http://127.0.0.1:3000",
    "accessToken": "",
    "ownerQq": ""
  },
  "llm": {
    "provider": "deepseek",
    "fallbacks": [],
    "allowFallback": true,
    "providers": {
      "deepseek": {
        "type": "openai-compatible",
        "baseUrl": "https://api.deepseek.com/v1",
        "apiKeyEnv": "DEEPSEEK_API_KEY",
        "model": "deepseek-chat",
        "capabilities": {"tools": true}
      },
      "zhipu": {
        "type": "openai-compatible",
        "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
        "apiKeyEnv": "ZHIPU_API_KEY",
        "model": "glm-4-flash",
        "capabilities": {"tools": true}
      },
      "qwen": {
        "type": "openai-compatible",
        "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "apiKeyEnv": "DASHSCOPE_API_KEY",
        "model": "qwen-plus",
        "capabilities": {"tools": true}
      },
      "moonshot": {
        "type": "openai-compatible",
        "baseUrl": "https://api.moonshot.cn/v1",
        "apiKeyEnv": "MOONSHOT_API_KEY",
        "model": "moonshot-v1-8k",
        "capabilities": {"tools": true}
      },
      "siliconflow": {
        "type": "openai-compatible",
        "baseUrl": "https://api.siliconflow.cn/v1",
        "apiKeyEnv": "SILICONFLOW_API_KEY",
        "model": "deepseek-ai/DeepSeek-V3",
        "capabilities": {"tools": true}
      }
    }
  },
  "scheduler": {
    "batchWindowMs": 8000,
    "wakeProbability": 0.04,
    "mentionDiveProbability": 0.05,
    "names": ["小皮"],
    "keywords": ["今晚开黑", "出来玩"],
    "maxWakesPerMinute": 4,
    "maxWakesPerHour": 20,
    "maxConcurrent": 4,
    "maxToolSteps": 6,
    "maxTextFallback": true,
    "noActionLimit": 2,
    "preSleepWaitMinutes": 5,
    "minSleepMs": 60000,
    "maxSleepMs": 14400000,
    "cooldownSeconds": 90
  },
  "tokenBudget": {
    "wakeMessages": 12,
    "historyMessages": 28,
    "eventTextChars": 160,
    "toolResultChars": 1600
  },
  "learning": {
    "enabled": true,
    "intervalMinutes": 20,
    "minNewMessages": 10,
    "confidenceThreshold": 0.7,
    "maxNotesPerSession": 20,
    "notesTtlDays": 7,
    "maxObservationsPerSession": 250,
    "excludeMembers": []
  },
  "safety": {
    "allowGroups": ["100000"],
    "allowPrivate": [],
    "maxGroupMembers": 20,
    "maxSendsPerMinute": 4,
    "maxSendsPerHour": 60,
    "maxSendsPerDay": 200,
    "maxSendsPerWake": 3,
    "maxMessageChars": 200,
    "maxImageBytes": 8388608,
    "maxImagePixels": 40960000
  },
  "console": {
    "host": "127.0.0.1",
    "port": 3100,
    "token": ""
  },
  "storage": {
    "dir": "state",
    "databasePath": "state/qqf.db"
  },
  "personaPath": "personas/default.yaml",
  "stickerDir": "stickers",
  "sticker": {
    "enabled": false,
    "allowedIds": ["pilot-01"],
    "autoTag": {
      "enabled": false,
      "provider": "vision-main",
      "fallbacks": ["vision-backup"],
      "providers": {
        "vision-main": {
          "type": "openai-compatible",
          "baseUrl": "https://example.invalid/v1",
          "apiKeyEnv": "QQF_VISION_API_KEY",
          "model": "vision-model",
          "timeoutSeconds": 120,
          "maxRetries": 1
        },
        "vision-backup": {
          "type": "openai-compatible",
          "baseUrl": "https://backup.invalid/v1",
          "apiKeyEnv": "QQF_VISION_BACKUP_API_KEY",
          "model": "vision-backup-model"
        }
      }
    }
  }
}
